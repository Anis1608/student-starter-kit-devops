# =============================================================================
# Git Ignore - Protect Sensitive Secrets & Ignore Build Artifacts
# =============================================================================

# 🔒 NEVER COMMIT SECRETS OR ENV FILES
.env
.env.*
!.env.example
.student-config.json
*.pem
*.key
kubeconfig*

# 📦 Dependencies
node_modules/
.pnpm-store/

# 🏗️ Build Artifacts
dist/
build/
coverage/
.next/
out/

# 📝 Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 💻 OS & IDE Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
