# =============================================================================
# Backend Environment Variables (TEMPLATE)
# Rename this file to '.env' and fill your real values.
# ⚠️ .env is ignored by git and will NEVER be pushed to GitHub!
# =============================================================================

PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
# Local Docker: mongodb://mongo:27017/studentdb
# Atlas: mongodb+srv://<username>:<password>@cluster0.abc.mongodb.net/mydb?retryWrites=true&w=majority
MONGO_URI=mongodb://mongo:27017/studentdb

# JWT Secret Key for Authentication
JWT_SECRET=your_super_secret_jwt_key_here
