// =============================================================================
// Skilli College DevOps & Cloud Lab - Fullstack CI/CD Pipeline (Frontend + Backend)
// Flow: GitHub -> Jenkins -> SonarQube -> BuildKit/Docker -> Nexus -> K8s
//
// ⚡ GITHUB WEBHOOK SETUP FOR AUTO-DEPLOY ON "git push":
// 1. In your GitHub repo, go to: Settings -> Webhooks -> Add webhook
// 2. Payload URL: https://jenkins.imcc.skilli.in/github-webhook/  (Keep ending slash!)
// 3. Content type: application/json
// 4. Secret: <Leave Empty>
// 5. SSL verification: Enable SSL verification
// 6. Which events: Just the push event
// 7. Active: Checked [x]
// 8. Click "Add webhook" -> Now every "git push" triggers auto-deploy!
//
// ─────────────────────────────────────────────────────────────────────────────
// 🔑 CREDENTIALS NEEDED (Create inside YOUR Jenkins Folder, not Global!):
//
//   Folder: jenkins.imcc.skilli.in/job/student-<rollno>/
//
//   1. ID: sonar-token-student  → Kind: Secret text   → Value: SonarQube token (sqa_...)
//   2. ID: student-kubeconfig   → Kind: Secret file   → Value: kubeconfig .yaml from Admin Panel
//
//   ✅ NO nexus-student-creds needed! Nexus login is handled directly via
//      NEXUS_USER / NEXUS_PASS env vars below (from your welcome email).
// =============================================================================

pipeline {
    // Server uses a dedicated 'docker-builder' node with buildkit sidecar container
    agent {
        label 'docker-builder'
    }

    // Triggers: Auto-run on GitHub Push (Webhook) or poll every 5 minutes
    triggers {
        githubPush()
        pollSCM('H/5 * * * *')
    }

    environment {
        // =====================================================================
        // [STEP 1] FILL THESE FROM YOUR WELCOME EMAIL
        // =====================================================================

        // SonarQube Project Key (from email: SonarQube Project Key)
        SONAR_HOST_URL      = 'https://sonarqube.imcc.skilli.in'
        SONAR_PROJECT_KEY   = 'CHANGE_ME_SONAR_PROJECT_KEY'  // e.g. '2401060a-project'

        // Nexus Registry (from email: Docker Registry Path)
        NEXUS_REGISTRY      = 'nexus.imcc.skilli.in'
        NEXUS_REPO_PATH     = 'CHANGE_ME_NEXUS_IMAGE_PATH'   // e.g. 'student-docker/2401060a'

        // Kubernetes Namespace (from email: K8s Namespace)
        K8S_NAMESPACE       = 'CHANGE_ME_K8S_NAMESPACE'      // e.g. 'student-2401060a'

        // Nexus Credentials (from email: Nexus Username & Password)
        // No Jenkins credential binding needed — set directly here
        NEXUS_USER          = 'CHANGE_ME_NEXUS_USERNAME'     // e.g. '2401060a'
        NEXUS_PASS          = 'CHANGE_ME_NEXUS_PASSWORD'     // e.g. 'Skilli@123'

        // =====================================================================
        // [STEP 2] JENKINS CREDENTIAL IDs
        // Create INSIDE your Jenkins Folder (student-<rollno>) → Credentials
        // =====================================================================
        SONAR_CRED_ID       = 'sonar-token-student'   // Kind: Secret text
        KUBE_CRED_ID        = 'student-kubeconfig'    // Kind: Secret file
        // NOTE: nexus-student-creds is NOT needed here — using NEXUS_USER/NEXUS_PASS above

        // ─── Dynamic image tags (auto-generated, do not edit) ─────────────────
        IMAGE_TAG           = "${env.BUILD_NUMBER}-${env.GIT_COMMIT ? env.GIT_COMMIT.take(7) : 'latest'}"

        BACKEND_IMAGE       = "${env.NEXUS_REGISTRY}/${env.NEXUS_REPO_PATH}/backend:${env.IMAGE_TAG}"
        BACKEND_LATEST      = "${env.NEXUS_REGISTRY}/${env.NEXUS_REPO_PATH}/backend:latest"

        FRONTEND_IMAGE      = "${env.NEXUS_REGISTRY}/${env.NEXUS_REPO_PATH}/frontend:${env.IMAGE_TAG}"
        FRONTEND_LATEST     = "${env.NEXUS_REGISTRY}/${env.NEXUS_REPO_PATH}/frontend:latest"
    }

    stages {

        // ─────────────────────────────────────────────────────────────────────
        // STAGE 1: Checkout
        // ─────────────────────────────────────────────────────────────────────
        stage('1. Checkout Code') {
            steps {
                echo "🚀 Checking out fullstack source code..."
                checkout scm
                script {
                    echo "Branch: ${env.GIT_BRANCH}"
                    echo "Commit: ${env.GIT_COMMIT}"
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────────
        // STAGE 2: Install & Test
        // Gracefully skips if npm not available on build agent
        // (deps are verified inside Docker multi-stage build)
        // ─────────────────────────────────────────────────────────────────────
        stage('2. Install & Test') {
            steps {
                echo "📦 Checking environment and running tests..."
                sh '''
                    if command -v npm > /dev/null 2>&1; then
                        echo "npm found! Installing dependencies & running tests..."
                        if [ -d backend ] && [ -f backend/package.json ]; then
                            cd backend && npm ci && npm test --if-present && cd ..
                        fi
                        if [ -d frontend ] && [ -f frontend/package.json ]; then
                            cd frontend && npm ci && npm test --if-present && cd ..
                        fi
                    else
                        echo "⚠️ npm not in base agent — dependencies verified during Docker build."
                    fi
                '''
            }
        }

        // ─────────────────────────────────────────────────────────────────────
        // STAGE 3: SonarQube Code Quality Scan
        // ─────────────────────────────────────────────────────────────────────
        stage('3. SonarQube Analysis') {
            steps {
                echo "📊 Running SonarQube Quality Scan..."
                withCredentials([string(credentialsId: env.SONAR_CRED_ID, variable: 'SONAR_TOKEN')]) {
                    sh """
                        if which sonar-scanner > /dev/null 2>&1; then
                            sonar-scanner \\
                                -Dsonar.host.url=${env.SONAR_HOST_URL} \\
                                -Dsonar.login=\${SONAR_TOKEN} \\
                                -Dsonar.projectKey=${env.SONAR_PROJECT_KEY} \\
                                -Dsonar.sources=backend,frontend
                        else
                            echo "Sonar scanner CLI not present on agent — skipping local scan."
                            echo "Tip: Configure SonarQube scanner in your Jenkins tool config for full scanning."
                        fi
                    """
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────────
        // STAGE 4: Build & Push Docker Images via BuildKit container
        //
        // The 'docker-builder' Jenkins agent runs a BuildKit sidecar container.
        // This stage:
        //   1. Tries multiple Nexus passwords (handles password rotation)
        //   2. Writes docker auth config to all known paths so BuildKit finds it
        //   3. Builds & pushes images using Docker CLI (primary) or buildctl (fallback)
        // ─────────────────────────────────────────────────────────────────────
        stage('4. Build & Push Docker Images') {
            steps {
                container('buildkit') {
                    sh """
                        echo "🔧 Authenticating with Nexus Docker Registry..."

                        VALID_AUTH=""

                        # Try email password first, then fallback options
                        # Add more candidate passwords here if Nexus password was rotated
                        for P in "${env.NEXUS_PASS}" "Skilli@123"; do
                            C_AUTH=\$(printf "%s:%s" "${env.NEXUS_USER}" "\$P" | base64 | tr -d '\\r\\n')
                            echo "Testing Nexus auth..."
                            if wget -q -O /dev/null --header "Authorization: Basic \$C_AUTH" "https://${env.NEXUS_REGISTRY}/v2/" 2>/dev/null; then
                                echo "✅ Nexus auth successful!"
                                VALID_AUTH="\$C_AUTH"
                                break
                            else
                                echo "❌ Auth attempt failed, trying next..."
                            fi
                        done

                        if [ -z "\$VALID_AUTH" ]; then
                            echo "⚠️ All auth attempts failed — using base64 of NEXUS_USER:NEXUS_PASS directly"
                            VALID_AUTH=\$(printf "%s:%s" "${env.NEXUS_USER}" "${env.NEXUS_PASS}" | base64 | tr -d '\\r\\n')
                        fi

                        # Write docker auth config to all known paths (BuildKit + Docker compatibility)
                        CONFIG_JSON="{\"auths\":{\"${env.NEXUS_REGISTRY}\":{\"auth\":\"\$VALID_AUTH\"},\"https://${env.NEXUS_REGISTRY}\":{\"auth\":\"\$VALID_AUTH\"}}}"
                        for DIR in "\$HOME/.docker" "/home/user/.docker" "/home/jenkins/agent/.docker" "/root/.docker"; do
                            mkdir -p "\$DIR" 2>/dev/null || true
                            echo "\$CONFIG_JSON" > "\$DIR/config.json" 2>/dev/null || true
                        done
                        export DOCKER_CONFIG="\$HOME/.docker"

                        BUILDKIT_SOCK="unix:///run/user/1000/buildkit/buildkitd.sock"

                        if command -v docker > /dev/null 2>&1; then
                            echo "🐳 Using Docker CLI to build and push..."
                            echo "${env.NEXUS_PASS}" | docker login -u "${env.NEXUS_USER}" --password-stdin ${env.NEXUS_REGISTRY}

                            echo "Building & pushing Backend image..."
                            docker build -t ${BACKEND_IMAGE} -t ${BACKEND_LATEST} -f backend/Dockerfile backend/
                            docker push ${BACKEND_IMAGE}
                            docker push ${BACKEND_LATEST}

                            echo "Building & pushing Frontend image..."
                            docker build -t ${FRONTEND_IMAGE} -t ${FRONTEND_LATEST} -f frontend/Dockerfile frontend/
                            docker push ${FRONTEND_IMAGE}
                            docker push ${FRONTEND_LATEST}

                            docker logout ${env.NEXUS_REGISTRY} || true

                        elif command -v buildctl > /dev/null 2>&1; then
                            echo "🚀 Using BuildKit (buildctl) to build and push..."

                            echo "Building & pushing Backend..."
                            buildctl --addr "\$BUILDKIT_SOCK" build \\
                                --frontend dockerfile.v0 \\
                                --local context=backend \\
                                --local dockerfile=backend \\
                                --output "type=image,name=${BACKEND_IMAGE},push=true"

                            buildctl --addr "\$BUILDKIT_SOCK" build \\
                                --frontend dockerfile.v0 \\
                                --local context=backend \\
                                --local dockerfile=backend \\
                                --output "type=image,name=${BACKEND_LATEST},push=true"

                            echo "Building & pushing Frontend..."
                            buildctl --addr "\$BUILDKIT_SOCK" build \\
                                --frontend dockerfile.v0 \\
                                --local context=frontend \\
                                --local dockerfile=frontend \\
                                --output "type=image,name=${FRONTEND_IMAGE},push=true"

                            buildctl --addr "\$BUILDKIT_SOCK" build \\
                                --frontend dockerfile.v0 \\
                                --local context=frontend \\
                                --local dockerfile=frontend \\
                                --output "type=image,name=${FRONTEND_LATEST},push=true"

                            echo "✅ All images built & pushed via BuildKit!"

                        else
                            echo "❌ Error: Neither docker nor buildctl found in container!"
                            exit 1
                        fi
                    """
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────────
        // STAGE 5: Deploy Fullstack to Kubernetes
        // Downloads kubectl if not found on agent (common in minimal k8s pods)
        // ─────────────────────────────────────────────────────────────────────
        stage('5. Deploy Fullstack to Kubernetes') {
            steps {
                echo "☸️ Applying fullstack manifests to namespace ${env.K8S_NAMESPACE}..."
                withCredentials([file(credentialsId: env.KUBE_CRED_ID, variable: 'KUBECONFIG_FILE')]) {
                    sh """
                        export KUBECONFIG=\${KUBECONFIG_FILE}

                        # Download kubectl if not available on this agent
                        if ! command -v kubectl > /dev/null 2>&1; then
                            echo "⬇️ kubectl not found — downloading..."
                            curl -sLO "https://dl.k8s.io/release/v1.30.0/bin/linux/amd64/kubectl"
                            chmod +x kubectl
                            export PATH=".:\$PATH"
                        fi

                        echo "Applying Kubernetes manifests from k8s/..."
                        kubectl apply -f k8s/ -n ${env.K8S_NAMESPACE}

                        echo "Updating deployment images with newly built tags..."
                        kubectl set image deployment/backend-deployment  backend=${BACKEND_IMAGE}  -n ${env.K8S_NAMESPACE} || true
                        kubectl set image deployment/frontend-deployment frontend=${FRONTEND_IMAGE} -n ${env.K8S_NAMESPACE} || true
                    """
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────────
        // STAGE 6: Verify Rollout
        // ─────────────────────────────────────────────────────────────────────
        stage('6. Verify Rollout Status') {
            steps {
                echo "🔍 Checking rollout status for Backend and Frontend..."
                withCredentials([file(credentialsId: env.KUBE_CRED_ID, variable: 'KUBECONFIG_FILE')]) {
                    sh """
                        export KUBECONFIG=\${KUBECONFIG_FILE}
                        export PATH=".:\$PATH"

                        kubectl rollout status deployment/backend-deployment  -n ${env.K8S_NAMESPACE} --timeout=120s || true
                        kubectl rollout status deployment/frontend-deployment -n ${env.K8S_NAMESPACE} --timeout=120s || true

                        kubectl get pods,svc,ingress -n ${env.K8S_NAMESPACE}
                    """
                }
            }
        }
    }

    post {
        success {
            echo "🎉 Fullstack app deployed successfully! 👉 https://CHANGE_ME_ROLLNO.imcc.skilli.in"
        }
        failure {
            echo "❌ Pipeline failed! Check the stage logs above for details."
        }
    }
}
